#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"

// 원본: mote_icon.png → make_icon.py로 생성 (16~256px)
IDI_APP ICON "mote.ico"

// 네이티브 메뉴바로 붙이지 않고, 상단 바 버튼에서 팝업으로만 사용한다
IDR_MAINMENU MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "&New\tCtrl+N",            IDM_FILE_NEW
        MENUITEM "New &Window\tCtrl+Shift+N", IDM_FILE_NEWWINDOW
        MENUITEM "&Open...\tCtrl+O",        IDM_FILE_OPEN
        // 항목은 메뉴가 열릴 때 최근 파일 목록으로 다시 채운다
        POPUP "Open &Recent"
        BEGIN
            MENUITEM "(Empty)",             IDM_FILE_RECENT_EMPTY, GRAYED
        END
        MENUITEM "&Save\tCtrl+S",           IDM_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+Shift+S", IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_FILE_EXIT
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           IDM_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",           IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",            IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",           IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",          IDM_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",     IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",        IDM_EDIT_FIND
        MENUITEM "Find &Next\tF3",          IDM_EDIT_FINDNEXT
        MENUITEM "Find Pre&vious\tShift+F3", IDM_EDIT_FINDPREV
        MENUITEM "R&eplace...\tCtrl+H",     IDM_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "Hide &Toolbar\tCtrl+\\",  IDM_VIEW_TOOLBAR
    END
    POPUP "Help"
    BEGIN
        MENUITEM "&Shortcuts and Features\tF1", IDM_HELP_SHORTCUTS
        MENUITEM SEPARATOR
        MENUITEM "&About mote",             IDM_HELP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Add mote to ""Open with""...", IDM_HELP_REGISTER
    END
END

// Windows 표시 언어가 한국어일 때 쓰는 같은 구조의 메뉴 (항목 순서와 ID가 위와 같아야 한다)
IDR_MAINMENU_KO MENU
BEGIN
    POPUP "파일"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",         IDM_FILE_NEW
        MENUITEM "새 창(&W)\tCtrl+Shift+N",         IDM_FILE_NEWWINDOW
        MENUITEM "열기(&O)...\tCtrl+O",             IDM_FILE_OPEN
        POPUP "최근 파일(&R)"
        BEGIN
            MENUITEM "(없음)",                      IDM_FILE_RECENT_EMPTY, GRAYED
        END
        MENUITEM "저장(&S)\tCtrl+S",                IDM_FILE_SAVE
        MENUITEM "다른 이름으로 저장(&A)...\tCtrl+Shift+S", IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                      IDM_FILE_EXIT
    END
    POPUP "편집"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",           IDM_EDIT_UNDO
        MENUITEM "다시 실행(&R)\tCtrl+Y",           IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",            IDM_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",                IDM_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",            IDM_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A",           IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "찾기(&F)...\tCtrl+F",             IDM_EDIT_FIND
        MENUITEM "다음 찾기(&N)\tF3",               IDM_EDIT_FINDNEXT
        MENUITEM "이전 찾기(&V)\tShift+F3",         IDM_EDIT_FINDPREV
        MENUITEM "바꾸기(&E)...\tCtrl+H",           IDM_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "툴바 숨기기(&T)\tCtrl+\\",        IDM_VIEW_TOOLBAR
    END
    POPUP "도움말"
    BEGIN
        MENUITEM "단축키 및 기능(&K)\tF1",          IDM_HELP_SHORTCUTS
        MENUITEM SEPARATOR
        MENUITEM "mote 정보(&A)",                   IDM_HELP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "연결 프로그램에 mote 등록...",      IDM_HELP_REGISTER
    END
END

// 편집 단축키(Ctrl+C/V/X/Z/Y/A)는 RichEdit 기본 처리에 맡긴다.
// 가속키로 가로채면 찾기 대화상자 입력란 등 다른 컨트롤에서 동작하지 않기 때문이다.
IDR_ACCEL ACCELERATORS
BEGIN
    "N",    IDM_FILE_NEW,       VIRTKEY, CONTROL
    "N",    IDM_FILE_NEWWINDOW, VIRTKEY, CONTROL, SHIFT
    "O",    IDM_FILE_OPEN,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVE,      VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVEAS,    VIRTKEY, CONTROL, SHIFT
    "B",    IDM_FORMAT_BOLD,    VIRTKEY, CONTROL
    "I",    IDM_FORMAT_ITALIC,  VIRTKEY, CONTROL
    "U",    IDM_FORMAT_UNDERLINE, VIRTKEY, CONTROL
    VK_F1,  IDM_FORMAT_COLOR_SLOT1, VIRTKEY, CONTROL
    VK_F2,  IDM_FORMAT_COLOR_SLOT2, VIRTKEY, CONTROL
    VK_F3,  IDM_FORMAT_COLOR_SLOT3, VIRTKEY, CONTROL
    "F",    IDM_EDIT_FIND,      VIRTKEY, CONTROL
    "H",    IDM_EDIT_REPLACE,   VIRTKEY, CONTROL
    VK_F3,  IDM_EDIT_FINDNEXT,  VIRTKEY
    VK_F3,  IDM_EDIT_FINDPREV,  VIRTKEY, SHIFT
    VK_OEM_5, IDM_VIEW_TOOLBAR, VIRTKEY, CONTROL
    "F",    IDM_OPEN_FILE_MENU, VIRTKEY, ALT
    "E",    IDM_OPEN_EDIT_MENU, VIRTKEY, ALT
    "H",    IDM_OPEN_HELP_MENU, VIRTKEY, ALT
    VK_F1,  IDM_HELP_SHORTCUTS, VIRTKEY
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MOTE_VERSION_MAJOR,MOTE_VERSION_MINOR,MOTE_VERSION_PATCH,0
PRODUCTVERSION  MOTE_VERSION_MAJOR,MOTE_VERSION_MINOR,MOTE_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "FileDescription",  "mote"
            VALUE "FileVersion",      MOTE_VERSION_STR
            VALUE "InternalName",     "mote"
            VALUE "OriginalFilename", "mote.exe"
            VALUE "ProductName",      "mote"
            VALUE "ProductVersion",   MOTE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
